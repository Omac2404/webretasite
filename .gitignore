# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (local user settings)
.claude/settings.local.json

# local feedback assets (annotated mockups, design references)
/screenshots

# runtime user data — kullanıcının gönderdiği form verileri git'e girmesin.
# NOT: smtp.json bilinçli olarak takip ediliyor ki SMTP ayarları makineler
# arasında senkron olsun (içinde e-posta şifresi de var — repo özel).
/data/inquiries.json
/data/appointments.json
